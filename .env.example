# =====================================================================
# Base de Conhecimento — variáveis de ambiente (copie para server/.env)
# Documentação completa: docs/VARIAVEIS_DE_AMBIENTE.md
# =====================================================================

# --- Essenciais -------------------------------------------------------
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://kb:kb@localhost:5432/kb_dev
# Obrigatório em produção (mínimo 32 caracteres aleatórios): openssl rand -base64 48
APP_SECRET=
PUBLIC_BASE_URL=http://localhost:5173
APP_NAME=Base de Conhecimento LOGAE
APP_TIMEZONE=America/Sao_Paulo

# --- Sessão e segurança -----------------------------------------------
SESSION_TTL_HOURS=12
# Em produção (HTTPS): COOKIE_SECURE=true
COOKIE_SECURE=false
# true quando houver proxy reverso/balanceador na frente da aplicação
TRUST_PROXY=false
# Visitantes sem login podem ler artigos externos publicados e usar o chat
PUBLIC_ANONYMOUS_ACCESS=true

# --- Bloqueio de edição -------------------------------------------------
LOCK_TTL_SECONDS=120
LOCK_HEARTBEAT_SECONDS=30

# --- Armazenamento de arquivos -----------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3 compatível (AWS S3, MinIO, Cloudflare R2...). Requer bucket PRIVADO.
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
SIGNED_URL_TTL_SECONDS=300

# --- Limites de upload (MB) --------------------------------------------
MAX_IMAGE_MB=10
MAX_VIDEO_MB=200
MAX_ATTACHMENT_MB=25
MAX_DOCUMENT_MB=30
FFMPEG_PATH=ffmpeg
# Conversão de .doc via LibreOffice (headless). Desabilitada por padrão.
DOC_CONVERSION_ENABLED=false
SOFFICE_PATH=soffice

# --- Tickets -------------------------------------------------------------
TICKET_REOPEN_WINDOW_DAYS=7

# --- Inteligência artificial --------------------------------------------
# Claude (Anthropic). Sem a chave, o chat funciona no modo de consulta (somente trechos).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_SERVER_FALLBACKS=true
AI_MAX_SOURCES=6
AI_TIMEOUT_MS=60000
AI_CONVERSATION_RETENTION_DAYS=180
# Pesquisa semântica (opcional) — Voyage AI
VOYAGE_API_KEY=
EMBEDDINGS_MODEL=voyage-3.5

# --- Limites de requisições --------------------------------------------
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_TICKETS_PER_HOUR=20

LOG_LEVEL=info
SERVE_WEB=true
WEB_DIST_DIR=../web/dist

# --- Seed (somente no comando npm run seed) ----------------------------
# SEED_ADMIN_EMAIL=admin@empresa.com
# SEED_ADMIN_PASSWORD=
# SEED_DEMO=false
# SEED_TEST_USERS=false   # cria interno@teste.com e externo@teste.com (senha Teste@12345) — NUNCA em produção

# --- Contas de teste ---------------------------------------------------
# Exibe as contas de teste na tela de login. Mantenha false em produção.
TEST_LOGINS_ENABLED=false

# --- Integração com o Jira (Atualizações) --------------------------------
# Webhook: POST /api/integrations/jira/webhook com o cabeçalho X-Jira-Secret (ou ?secret=)
# JIRA_WEBHOOK_SECRET=
# Consulta à API (sincronização manual/periódica)
# JIRA_BASE_URL=https://suaempresa.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEYS=LOGAE,SUP
# Campos por nome ou id (customfield_XXXXX)
JIRA_RELEASE_FIELD=fixVersions
JIRA_AUDIENCE_FIELD=Público alvo
JIRA_DONE_STATUSES=Done,Concluído,Concluida,Concluída,Finalizado,Resolvido
# Minutos entre sincronizações automáticas (0 = desativado)
JIRA_SYNC_MINUTES=0
