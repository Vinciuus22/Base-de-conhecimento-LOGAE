{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts src/cli/migrate.ts src/cli/seed.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outdir=dist --tsconfig=tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/lib-storage": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "file-type": "^22.1.1",
    "mammoth": "^1.13.0",
    "pg": "^8.23.1",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "unpdf": "^1.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
